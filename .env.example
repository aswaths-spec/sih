# GEMINI_API_KEY: Required for optional AI-assisted triage insights.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# JWT Secret for session authentication and role tokens
JWT_SECRET="caregrid_super_secret_jwt_key_2026_change_in_production"

# Database connection URL (PostgreSQL specification for production deployment)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/caregrid?schema=public"

# Teleconsultation / eSanjeevani Mock Provider Configuration
ESANJEEVANI_GATEWAY_URL="https://mock.esanjeevani.gov.in/api/v1"
ABDM_SANDBOX_CLIENT_ID="caregrid-abdm-sandbox"

